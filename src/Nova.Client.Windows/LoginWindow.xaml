<Window
    x:Class="Nova.Client.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nova">

    <Grid Background="{ThemeResource NovaBackgroundBrush}">
        <Border Width="430" Padding="34" CornerRadius="22"
                Background="{ThemeResource NovaSurfaceBrush}"
                BorderBrush="{ThemeResource NovaBorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                    <TextBlock Text="nova" FontSize="34" FontWeight="SemiBold"
                               Foreground="{ThemeResource NovaTextBrush}"/>
                    <TextBlock Text="Your conversations. Your space."
                               Foreground="{ThemeResource NovaMutedTextBrush}"/>
                </StackPanel>

                <TextBox x:Name="UsernameBox" Header="Username" PlaceholderText="username"/>
                <PasswordBox x:Name="PasswordBox" Header="Password" PlaceholderText="Password"/>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                           Foreground="{ThemeResource NovaMutedTextBrush}"/>

                <Button x:Name="LoginButton" Content="Sign in" Click="LoginButton_Click"
                        HorizontalAlignment="Stretch" MinHeight="44"/>
                <Button x:Name="RegisterButton" Content="Create account" Click="RegisterButton_Click"
                        HorizontalAlignment="Stretch" MinHeight="40"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="Backend URL" FontSize="12"
                               Foreground="{ThemeResource NovaMutedTextBrush}"/>
                    <TextBox x:Name="ApiUrlBox" Text="http://localhost:8080"
                             PlaceholderText="https://api.example.com"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>