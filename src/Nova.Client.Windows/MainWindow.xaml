<Window
    x:Class="Nova.Client.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nova">

    <Grid Background="{ThemeResource NovaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thin adaptive utility bar. Intentionally quiet when unused. -->
        <Border Grid.Row="0" Background="{ThemeResource NovaSurfaceBrush}" BorderBrush="{ThemeResource NovaBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="12,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="UtilityContextText"
                               Text=""
                               FontSize="12"
                               Foreground="{ThemeResource NovaMutedTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="UtilityProfileButton"
                            Content="Profile"
                            Click="ProfileButton_Click"
                            Padding="10,2"
                            MinHeight="26"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="8" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ServerRailColumn" Width="62"/>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Server rail: expands on hover. -->
            <Border x:Name="ServerRail"
                    Grid.Column="0"
                    CornerRadius="14"
                    Background="{ThemeResource NovaSurfaceBrush}"
                    BorderBrush="{ThemeResource NovaBorderBrush}"
                    BorderThickness="1"
                    PointerEntered="ServerRail_PointerEntered"
                    PointerExited="ServerRail_PointerExited">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Padding="10,12" Spacing="8">
                        <Button Content="N"
                                FontSize="18"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                Click="HomeButton_Click"
                                ToolTipService.ToolTip="Nova Home"/>
                        <Button Content="+"
                                FontSize="18"
                                HorizontalContentAlignment="Center"
                                Click="AddServerButton_Click"
                                ToolTipService.ToolTip="Add server"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ServerList" Padding="10,4" Spacing="7">
                            <Button Content="A" Click="ServerButton_Click" ToolTipService.ToolTip="Example server"/>
                            <Button Content="B" Click="ServerButton_Click" ToolTipService.ToolTip="Example server"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Margin="10,8,10,10"
                            Content="Settings"
                            Click="SettingsButton_Click"
                            ToolTipService.ToolTip="Settings"/>
                </Grid>
            </Border>

            <!-- 2. DM / channel navigation. -->
            <Border Grid.Column="1"
                    CornerRadius="14"
                    Background="{ThemeResource NovaSurfaceBrush}"
                    BorderBrush="{ThemeResource NovaBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Padding="18,16,18,10" Spacing="2">
                        <TextBlock Text="Messages"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource NovaTextBrush}"/>
                        <TextBlock Text="Direct conversations"
                                   FontSize="12"
                                   Foreground="{ThemeResource NovaMutedTextBrush}"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Margin="14,4,14,10"
                             PlaceholderText="Search messages and people"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="10,0,10,10" Spacing="6">
                            <TextBlock Text="Pinned"
                                       Margin="8,8,8,2"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource NovaMutedTextBrush}"/>
                            <Button Content="★  Alex"
                                    HorizontalContentAlignment="Left"
                                    Click="ConversationButton_Click"/>
                            <Button Content="★  Jamie"
                                    HorizontalContentAlignment="Left"
                                    Click="ConversationButton_Click"/>

                            <Expander Header="Friends" IsExpanded="True" Margin="0,6,0,0">
                                <StackPanel Spacing="3" Padding="4,3,4,6">
                                    <Button Content="Taylor" HorizontalContentAlignment="Left" Click="ConversationButton_Click"/>
                                    <Button Content="Jordan" HorizontalContentAlignment="Left" Click="ConversationButton_Click"/>
                                    <Button Content="Sam" HorizontalContentAlignment="Left" Click="ConversationButton_Click"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="School" IsExpanded="True">
                                <StackPanel Spacing="3" Padding="4,3,4,6">
                                    <Button Content="Morgan" HorizontalContentAlignment="Left" Click="ConversationButton_Click"/>
                                    <Button Content="Casey" HorizontalContentAlignment="Left" Click="ConversationButton_Click"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Other" IsExpanded="False">
                                <StackPanel Spacing="3" Padding="4,3,4,6">
                                    <Button Content="Riley" HorizontalContentAlignment="Left" Click="ConversationButton_Click"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3"
                            Padding="12,9"
                            Background="{ThemeResource NovaElevatedBrush}"
                            BorderBrush="{ThemeResource NovaBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Button Content="+  Add group"
                                Click="AddGroupButton_Click"
                                HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Main conversation. -->
            <Border Grid.Column="2"
                    CornerRadius="14"
                    Background="{ThemeResource NovaSurfaceBrush}"
                    BorderBrush="{ThemeResource NovaBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="18,10"
                            BorderBrush="{ThemeResource NovaBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Alex"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Click="ProfileButton_Click"
                                    HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Content="Call" Click="CallButton_Click"/>
                                <Button Content="Search" Click="SearchButton_Click"/>
                                <Button Content="•••" Click="MoreButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="MessageScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MessageList" Padding="22,18" Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Alex" FontWeight="SemiBold" Foreground="{ThemeResource NovaTextBrush}"/>
                                <TextBlock Text="Hey! Welcome to the new Nova layout." TextWrapping="Wrap" Foreground="{ThemeResource NovaTextBrush}"/>
                                <TextBlock Text="12:41" FontSize="11" Foreground="{ThemeResource NovaMutedTextBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="You" FontWeight="SemiBold" Foreground="{ThemeResource NovaTextBrush}"/>
                                <TextBlock Text="This is way cleaner." TextWrapping="Wrap" Foreground="{ThemeResource NovaTextBrush}"/>
                                <TextBlock Text="12:42" FontSize="11" Foreground="{ThemeResource NovaMutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Padding="14,10,14,14" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageComposer"
                                 PlaceholderText="Message Alex"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="44"
                                 KeyDown="MessageComposer_KeyDown"/>
                        <Button Grid.Column="1"
                                Content="Send"
                                MinHeight="44"
                                Padding="18,0"
                                Click="SendMessageButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Account / contextual details panel. -->
            <Border x:Name="DetailsPanel"
                    Grid.Column="3"
                    CornerRadius="14"
                    Background="{ThemeResource NovaSurfaceBrush}"
                    BorderBrush="{ThemeResource NovaBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Account"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource NovaTextBrush}"/>
                        <Button Grid.Column="1" Content="Close" Click="ProfileButton_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Padding="18,4,18,20" Spacing="16">
                            <Border Height="96" CornerRadius="14" Background="{ThemeResource NovaElevatedBrush}">
                                <Grid>
                                    <Ellipse Width="58" Height="58" Fill="{ThemeResource NovaAccentBrush}"/>
                                    <TextBlock Text="A"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Grid>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Your display name" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NovaTextBrush}"/>
                                <TextBlock Text="@username" Foreground="{ThemeResource NovaMutedTextBrush}"/>
                                <TextBlock Text="Online" Foreground="{ThemeResource NovaAccentBrush}"/>
                            </StackPanel>
                            <Button Content="Account settings" Click="SettingsButton_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="Appearance" Click="SettingsButton_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="Notifications" Click="SettingsButton_Click" HorizontalAlignment="Stretch"/>
                            <Button Content="Privacy &amp; security" Click="SettingsButton_Click" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>