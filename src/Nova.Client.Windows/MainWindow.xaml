<Window
    x:Class="Nova.Client.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nova">
    <Grid Background="{ThemeResource NovaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="24,20,24,16" Background="{ThemeResource NovaSurfaceBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Nova" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource NovaTextBrush}"/>
                    <TextBlock Text="Modern communication, built for the future." Foreground="{ThemeResource NovaMutedTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Sign in" Click="SignIn_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Padding="24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="18" Background="{ThemeResource NovaSurfaceBrush}">
                <StackPanel Padding="12" Spacing="12">
                    <Button Content="Home"/>
                    <Button Content="DMs"/>
                    <Button Content="+"/>
                    <Button Content="Settings"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="18" Background="{ThemeResource NovaSurfaceBrush}" Padding="18">
                <StackPanel Spacing="16">
                    <TextBlock Text="Conversations" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NovaTextBrush}"/>
                    <TextBox PlaceholderText="Search"/>
                    <TextBlock Text="Your conversations will appear here." TextWrapping="Wrap" Foreground="{ThemeResource NovaMutedTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="18" Background="{ThemeResource NovaSurfaceBrush}" Padding="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <TextBlock Text="Welcome to Nova" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource NovaTextBrush}"/>
                    <TextBlock Text="The client foundation is ready. Authentication, realtime messaging, local state and encryption services plug into this shell." TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" Foreground="{ThemeResource NovaMutedTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" CornerRadius="18" Background="{ThemeResource NovaSurfaceBrush}" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Details" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource NovaTextBrush}"/>
                    <TextBlock Text="Profile, members, calls and contextual information will live here." TextWrapping="Wrap" Foreground="{ThemeResource NovaMutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
